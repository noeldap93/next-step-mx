# Maximum user replies per conversation. The bot will mark the conversation
# complete after this many user inputs.
MAX_QUESTIONS=10

# Anthropic model id. See https://docs.anthropic.com/en/docs/about-claude/models
MODEL=claude-sonnet-4-6

# ANTHROPIC_API_KEY is provisioned via Firebase secrets, NOT this file:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
