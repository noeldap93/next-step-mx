rules_version = '2';

// Two access patterns coexist:
//
// 1. Chatbot visitors: anonymous (no auth). They can read+write inside their
//    own user_id subtree, but cannot LIST the /users collection itself, so
//    the only way to reach a user's data is to already know the (un-guessable)
//    user_id that was shared with them.
//
// 2. Admins: signed in via Firebase Auth (Google). Granted full CRUD across
//    /users, /prompts, /admins. The bootstrap admin email is hardcoded so
//    the very first admin can sign in without anyone provisioning them.
//
// The Cloud Function uses the Admin SDK and bypasses these rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aragonknoel@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    // ----- Users -----
    match /users/{userId} {
      // Admins can do anything, including listing the collection.
      allow read, write: if isAdmin();

      // Anonymous chatbot visitors: get a known user by id (cannot enumerate).
      allow get: if true;
      allow create, update: if true;

      match /conversations/{convId} {
        // Anyone who reached this path knows the userId; that's the gate.
        allow read, write: if true;

        match /messages/{msgId} {
          allow read, write: if true;
        }
      }
    }

    // ----- Prompts -----
    match /prompts/{promptId} {
      allow read, write: if isAdmin();
      // Anonymous: read a known prompt by id, but not list/write.
      allow get: if true;
    }

    // ----- Admins -----
    // Only existing admins can read or modify the admin roster. The bootstrap
    // admin is allowed implicitly via isAdmin() above.
    match /admins/{email} {
      allow read, write: if isAdmin();
    }
  }
}
