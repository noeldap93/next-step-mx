# Endpoint for the chat Cloud Function. In production this is "/api/chat"
# (rewritten by Firebase Hosting). In dev with the Functions emulator, the
# Vite proxy forwards /api/chat to the emulator using VITE_FUNCTIONS_EMULATOR_PATH.
VITE_CHAT_ENDPOINT=/api/chat

# Used by the Vite dev proxy when calling the Functions emulator. Format:
# /<projectId>/<region>
VITE_FUNCTIONS_EMULATOR_PATH=/next-step-mx/us-central1
