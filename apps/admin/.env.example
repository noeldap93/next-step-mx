# Firebase web SDK config — fill from Firebase console
# Project settings → General → Your apps → Web app → SDK setup & config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=next-step-mx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=next-step-mx
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public origin for the chatbot. Used to build the shareable per-user link
# in the admin UI. Leave empty in dev and we'll fall back to window.location.origin.
VITE_CHATBOT_ORIGIN=
